{
  "name": "madwire-node-assessment",
  "description": "A take-home code assessment for Node.js job candidates",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/madwire-media/madwire-node-assessment.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "build/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "test": "DOTENV_CONFIG_PATH=__tests__/.env.test jest --runInBand",
    "test:watch": "yarn test --watch",
    "test:coverage": "yarn test --coverage",
    "test:ci": "DOTENV_CONFIG_PATH=__tests__/.env.test jest --runInBand --ci --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "dev": "nodemon --exec ts-node ./src/index.ts",
    "start": "node build/index.js",
    "build": "rimraf ./build && tsc",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.33",
    "dotenv": "^16.4.7",
    "fastify": "^5.8.5",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.13",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
